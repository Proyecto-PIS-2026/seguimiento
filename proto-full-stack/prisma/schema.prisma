generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actor_credentials {
  actor_id      String @id @db.Uuid
  role          String
  email         String @unique
  password_hash String
}

model market_settings {
  actor_id String @id
  schedule Json   @default("{\"days\": [\"mon\", \"tue\", \"wed\", \"thu\", \"fri\", \"sat\"], \"closing\": \"13:00\", \"opening\": \"04:00\"}")
  vacation Json   @default("{\"end\": \"\", \"start\": \"\", \"substitute\": null, \"description\": \"\"}")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model operators {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  nave        String   @db.VarChar(255)
  puesto      String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  responsible String   @db.VarChar(255)
  whatsapp    String   @db.VarChar(255)
  legal_name  String   @db.VarChar(255)
  address     String   @db.VarChar(255)
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model producers {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  responsible String   @db.VarChar(255)
  whatsapp    String   @db.VarChar(255)
  legal_name  String   @db.VarChar(255)
  address     String   @db.VarChar(255)
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model prototype_seeds {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model publications {
  id          BigInt   @id @default(autoincrement())
  actor_id    String
  role        String
  species_id  Int
  combination Json
  price       Decimal  @db.Decimal(12, 2)
  photo       String?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  active      Boolean  @default(true)

  @@unique([actor_id, species_id, combination])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recommended_prices {
  species_id Int      @id
  price      Decimal  @db.Decimal(12, 2)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recovery_requests {
  id         BigInt   @id @default(autoincrement())
  name       String
  email      String
  problem    String
  status     String   @default("Pendiente")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  token_hash String   @id
  role       String
  username   String
  actor_id   String?
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "sessions_expiry")
}

model smart_recommendations {
  id          BigInt @id @default(autoincrement())
  species_id  Int    @unique
  description String
}
